# ==============================================================================
# FFCS AGENT - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Cryptographic Keys (Item 3, 26: Generate with `openssl rand -hex 64`)
# Required in production. Server terminates on boot if weak/default in production.
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_key_in_production
WEBHOOK_SECRET=replace_with_secure_webhook_token_for_n8n_integration

# Database Configuration (Item 1, 7, 41: Open DB / credentials protection)
MONGODB_URI=mongodb://127.0.0.1:27017/ffcs-agent
# For MongoDB Atlas with TLS and least-privilege credentials:
# MONGODB_URI=mongodb+srv://<app_user>:<strong_password>@cluster.mongodb.net/ffcs-agent?retryWrites=true&w=majority

# File Upload Hardening (Item 21, 22)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Automation / Webhook Configuration (Item 31, 59)
N8N_WEBHOOK_URL=http://localhost:5678/webhook
